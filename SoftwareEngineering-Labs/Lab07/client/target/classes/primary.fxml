<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="il.cshaifasweng.OCSFMediatorExample.client.PrimaryController"
            prefWidth="420" prefHeight="500"
            style="-fx-background-color: #1e1e2e;">

   <top>
      <VBox alignment="CENTER" spacing="6" style="-fx-padding: 16 0 8 0;">
         <Label fx:id="statusLabel"
                text="Connecting..."
                style="-fx-text-fill: #cdd6f4; -fx-font-size: 16px; -fx-font-weight: bold;"/>
         <Label fx:id="symbolLabel"
                text=""
                style="-fx-text-fill: #89b4fa; -fx-font-size: 13px;"/>
      </VBox>
   </top>

   <center>
      <GridPane fx:id="boardGrid"
                alignment="CENTER"
                hgap="8" vgap="8"
                style="-fx-padding: 20;">

         <Button fx:id="btn00" GridPane.columnIndex="0" GridPane.rowIndex="0"
                 prefWidth="110" prefHeight="110"
                 style="-fx-font-size: 36px; -fx-font-weight: bold; -fx-background-color: #313244; -fx-text-fill: #cdd6f4; -fx-background-radius: 12; -fx-cursor: hand;"
                 onAction="#handleCellClick"/>
         <Button fx:id="btn01" GridPane.columnIndex="1" GridPane.rowIndex="0"
                 prefWidth="110" prefHeight="110"
                 style="-fx-font-size: 36px; -fx-font-weight: bold; -fx-background-color: #313244; -fx-text-fill: #cdd6f4; -fx-background-radius: 12; -fx-cursor: hand;"
                 onAction="#handleCellClick"/>
         <Button fx:id="btn02" GridPane.columnIndex="2" GridPane.rowIndex="0"
                 prefWidth="110" prefHeight="110"
                 style="-fx-font-size: 36px; -fx-font-weight: bold; -fx-background-color: #313244; -fx-text-fill: #cdd6f4; -fx-background-radius: 12; -fx-cursor: hand;"
                 onAction="#handleCellClick"/>

         <Button fx:id="btn10" GridPane.columnIndex="0" GridPane.rowIndex="1"
                 prefWidth="110" prefHeight="110"
                 style="-fx-font-size: 36px; -fx-font-weight: bold; -fx-background-color: #313244; -fx-text-fill: #cdd6f4; -fx-background-radius: 12; -fx-cursor: hand;"
                 onAction="#handleCellClick"/>
         <Button fx:id="btn11" GridPane.columnIndex="1" GridPane.rowIndex="1"
                 prefWidth="110" prefHeight="110"
                 style="-fx-font-size: 36px; -fx-font-weight: bold; -fx-background-color: #313244; -fx-text-fill: #cdd6f4; -fx-background-radius: 12; -fx-cursor: hand;"
                 onAction="#handleCellClick"/>
         <Button fx:id="btn12" GridPane.columnIndex="2" GridPane.rowIndex="1"
                 prefWidth="110" prefHeight="110"
                 style="-fx-font-size: 36px; -fx-font-weight: bold; -fx-background-color: #313244; -fx-text-fill: #cdd6f4; -fx-background-radius: 12; -fx-cursor: hand;"
                 onAction="#handleCellClick"/>

         <Button fx:id="btn20" GridPane.columnIndex="0" GridPane.rowIndex="2"
                 prefWidth="110" prefHeight="110"
                 style="-fx-font-size: 36px; -fx-font-weight: bold; -fx-background-color: #313244; -fx-text-fill: #cdd6f4; -fx-background-radius: 12; -fx-cursor: hand;"
                 onAction="#handleCellClick"/>
         <Button fx:id="btn21" GridPane.columnIndex="1" GridPane.rowIndex="2"
                 prefWidth="110" prefHeight="110"
                 style="-fx-font-size: 36px; -fx-font-weight: bold; -fx-background-color: #313244; -fx-text-fill: #cdd6f4; -fx-background-radius: 12; -fx-cursor: hand;"
                 onAction="#handleCellClick"/>
         <Button fx:id="btn22" GridPane.columnIndex="2" GridPane.rowIndex="2"
                 prefWidth="110" prefHeight="110"
                 style="-fx-font-size: 36px; -fx-font-weight: bold; -fx-background-color: #313244; -fx-text-fill: #cdd6f4; -fx-background-radius: 12; -fx-cursor: hand;"
                 onAction="#handleCellClick"/>
      </GridPane>
   </center>

   <bottom>
      <VBox alignment="CENTER" style="-fx-padding: 8 0 20 0;">
         <Label fx:id="resultLabel"
                text=""
                style="-fx-text-fill: #a6e3a1; -fx-font-size: 18px; -fx-font-weight: bold;"/>
      </VBox>
   </bottom>

</BorderPane>